<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Mist settles on one carved horizon</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: 100%; height: 100%; overflow: hidden; background: #d4c5a9; touch-action: none; -webkit-tap-highlight-color: transparent; }
canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }
</style>
</head>
<body>
<canvas id="c" width="1080" height="733" style="width: 1080px; height: 733px;"></canvas>
<script>
(function () {
  'use strict';

  var canvas = document.getElementById('c');
  var ctx = canvas.getContext('2d', { alpha: true, desynchronized: true });

  // House palette — ink on warm paper, mist as breath
  var PAPER = { r: 212, g: 197, b: 169 };
  var INK = { r: 22, g: 24, b: 42 };
  var MIST = { r: 222, g: 218, b: 210 };

  var W = 0, H = 0, dpr = 1;
  var lastT = 0;
  var globalTime = 0;

  // Assets (real file-backed, per contract v2)
  var assets = {
    paper: new Image(),
    mist: new Image(),
    horizon: new Image(),
    paperOk: false, mistOk: false, horizonOk: false
  };
  var assetsLoaded = 0;
  function assetDone() {
    assetsLoaded++;
    if (assetsLoaded >= 3) {
      // kick first paint once images are ready (or fell back)
      draw(16);
    }
  }
  assets.paper.onload = function () { assets.paperOk = true; assetDone(); };
  assets.mist.onload = function () { assets.mistOk = true; assetDone(); };
  assets.horizon.onload = function () { assets.horizonOk = true; assetDone(); };
  assets.paper.onerror = function () { assets.paperOk = false; assetDone(); };
  assets.mist.onerror = function () { assets.mistOk = false; assetDone(); };
  assets.horizon.onerror = function () { assets.horizonOk = false; assetDone(); };
  // Relative paths so file:// and preview trees both work
  assets.paper.src = 'assets/paper-washi-texture.jpg';
  assets.mist.src = 'assets/mist-veil-layer.jpg';
  assets.horizon.src = 'assets/horizon-ink-wave.jpg';

  // Interaction state — baren press
  var isPressing = false;
  var pressX = 0, pressY = 0;
  var pressDepth = 0;         // 0..1, eased build with resistance
  var pressTime = 0;          // ms sustained for resistance curve
  var cumulative = 0;         // slow global settling from quiet holds (ink memory + mist clearing)
  var lastPressCount = 0;
  var tapTimes = [];          // for frantic detection

  // Wave horizon (single dominant gesture, multiple harmonics)
  var waveBaseY = 0;
  var wavePoints = [];
  var wavePhase = 0;

  // Mist particles — primary expressive material, slow continuous drift
  var mist = [];
  var NUM_MIST = 38;

  // Local ink bleed / deepening marks from baren
  var bleeds = [];

  // Very sparse audio (dry baren drag only on sustained press)
  var audioCtx = null;
  var audioMaster = null;
  var lastDragAt = 0;

  function initAudioIfNeeded() {
    if (audioCtx) return;
    try {
      var AC = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AC();
      audioMaster = audioCtx.createGain();
      audioMaster.gain.value = 0.0001; // start silent; will ramp on gesture
      audioMaster.connect(audioCtx.destination);
    } catch (e) { /* silent fallback */ }
  }

  function playBarenDrag(intensity) {
    if (!audioCtx || !audioMaster) return;
    var now = audioCtx.currentTime;
    if (now - lastDragAt < 0.085) return; // throttle
    lastDragAt = now;

    var dur = 0.07 + intensity * 0.04;
    var src = audioCtx.createBufferSource();
    var len = Math.floor(audioCtx.sampleRate * (dur + 0.03));
    var buf = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
    var data = buf.getChannelData(0);
    for (var i = 0; i < len; i++) {
      var t = i / audioCtx.sampleRate;
      // dry fibrous noise, no tone
      data[i] = (Math.random() * 2 - 1) * (1 - t / (dur + 0.02)) * 0.9;
    }
    src.buffer = buf;

    var lp = audioCtx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = 620 + intensity * 380;

    var bp = audioCtx.createBiquadFilter();
    bp.type = 'bandpass';
    bp.frequency.value = 380 + intensity * 120;
    bp.Q.value = 1.6;

    var g = audioCtx.createGain();
    g.gain.value = 0.018 + intensity * 0.022;

    var decay = audioCtx.createGain();
    src.connect(bp);
    bp.connect(lp);
    lp.connect(g);
    g.connect(decay);
    decay.connect(audioMaster);

    var t0 = now;
    g.gain.setValueAtTime(g.gain.value, t0);
    g.gain.linearRampToValueAtTime(0.0008, t0 + dur + 0.04);
    src.start(t0);
    src.stop(t0 + dur + 0.12);
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2.0);
    W = Math.max(640, window.innerWidth);
    H = Math.max(480, window.innerHeight);
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    waveBaseY = Math.round(H * 0.495);
    wavePhase = Math.random() * Math.PI * 2;

    // Seed mist (slow continuous drift, different layers)
    mist = [];
    for (var i = 0; i < NUM_MIST; i++) {
      mist.push({
        x: Math.random() * W,
        y: H * (0.18 + Math.random() * 0.64),
        r: 38 + Math.random() * 92,
        vx: -0.011 - Math.random() * 0.017, // leftward drift, slight parallax
        vy: (Math.random() - 0.5) * 0.004,
        a: 0.035 + Math.random() * 0.055,
        phase: Math.random() * Math.PI * 2,
        layer: (i % 3) // 0 near, 1 mid, 2 far
      });
    }

    bleeds = [];
    generateWavePoints();
  }

  function generateWavePoints() {
    wavePoints = [];
    var n = 7;
    for (var i = 0; i <= n; i++) {
      var t = i / n;
      var x = 40 + t * (W - 80);
      var y = waveBaseY +
        Math.sin(t * 2.8 + 1.1) * (H * 0.055) +
        Math.sin(t * 5.7 + 0.4) * (H * 0.018);
      wavePoints.push({ x: x, y: y });
    }
  }

  // Easing for baren resistance (feels heavier at start of press)
  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function updatePress(dt, now) {
    var target = isPressing ? 1.0 : 0.0;

    if (isPressing) {
      pressTime += dt;
      // resistance: first ~220ms feels slower/heavier
      var resist = Math.max(0.28, 1 - Math.exp(-pressTime / 220));
      var eased = easeInOutCubic(resist);
      pressDepth += (target * eased - pressDepth) * 0.092;
      // accumulate quiet beauty only on sustained, not frantic
      if (pressDepth > 0.25 && !isFrantic()) {
        cumulative = Math.min(1.35, cumulative + dt * 0.000018 * (0.6 + pressDepth * 0.7));
      }
    } else {
      pressDepth *= 0.978;
      pressTime = Math.max(0, pressTime - dt * 1.6);
      cumulative *= 0.9996; // very slow memory fade
    }
    pressDepth = Math.max(0, Math.min(1.0, pressDepth));

    // record taps for frantic check (only counts quick successive downs)
    if (isPressing && dt < 80) {
      tapTimes.push(now);
      if (tapTimes.length > 9) tapTimes.shift();
    }
    // prune old taps
    while (tapTimes.length && now - tapTimes[0] > 820) tapTimes.shift();
  }

  function isFrantic() {
    return tapTimes.length >= 5 && (tapTimes[tapTimes.length - 1] - tapTimes[0]) < 620;
  }

  function updateMist(dt) {
    var frantic = isFrantic();
    for (var i = 0; i < mist.length; i++) {
      var m = mist[i];
      // base slow drift + very gentle vertical breath
      m.x += m.vx * (0.6 + m.layer * 0.22) * (dt / 16.6);
      m.y += m.vy * (dt / 16.6);
      m.phase += 0.0007 * (dt / 16.6);

      // wrap
      if (m.x < -m.r * 0.6) m.x = W + m.r * 0.3;
      if (m.x > W + m.r * 0.6) m.x = -m.r * 0.3;

      // local mist thinning + slight displacement under active baren
      if (pressDepth > 0.08) {
        var dx = m.x - pressX;
        var dy = m.y - pressY;
        var d = Math.hypot(dx, dy);
        if (d < m.r * 1.35) {
          var influence = (1 - d / (m.r * 1.35)) * pressDepth * (frantic ? 0.3 : 1.0);
          // push mist outward slowly + reduce local alpha
          m.x += (dx / (d + 1)) * influence * 0.9;
          m.y += (dy / (d + 1)) * influence * 0.45;
          m.a = Math.max(0.012, m.a * (1 - influence * 0.018));
        }
      }

      // very slow global clearing from long quiet cumulative holds
      if (cumulative > 0.1) {
        m.a = Math.max(0.009, m.a * (1 - cumulative * 0.0006));
      }

      // restore alpha slowly when idle
      if (!isPressing) {
        m.a = Math.min(0.09, m.a + 0.00008 * (dt / 16.6));
      }
    }
  }

  function addBleed(x, y, strength) {
    // outward bleeding ink marks that grow slowly while pressed
    var n = 1 + Math.floor(strength * 1.6);
    for (var i = 0; i < n; i++) {
      bleeds.push({
        x: x + (Math.random() - 0.5) * 11,
        y: y + (Math.random() - 0.5) * 7,
        r: 1.6 + Math.random() * 2.4,
        life: 0.6 + strength * 0.7,
        vx: (Math.random() - 0.5) * 0.08,
        vy: (Math.random() - 0.5) * 0.05
      });
    }
    if (bleeds.length > 26) bleeds.splice(0, bleeds.length - 26);
  }

  function updateBleeds(dt) {
    for (var i = bleeds.length - 1; i >= 0; i--) {
      var b = bleeds[i];
      b.life -= dt * 0.0009;
      b.x += b.vx * (dt / 16.6);
      b.y += b.vy * (dt / 16.6);
      b.r = Math.max(0.6, b.r + (pressDepth > 0.3 ? 0.012 : -0.003) * (dt / 16.6));
      if (b.life <= 0) bleeds.splice(i, 1);
    }
  }

  function updateWave(dt) {
    wavePhase += 0.0009 * (dt / 16.6);
    // slow breathing of the wave form
    for (var i = 0; i < wavePoints.length; i++) {
      var p = wavePoints[i];
      var t = i / (wavePoints.length - 1);
      var breathe = Math.sin(wavePhase * 0.6 + t * 3.1) * 0.6 +
                    Math.sin(wavePhase * 1.7 + t * 1.4) * 0.25;
      // press locally pulls the wave a tiny bit toward finger with resistance
      if (pressDepth > 0.1 && Math.abs(p.x - pressX) < 180) {
        var pd = pressDepth * (1 - Math.abs(p.x - pressX) / 180) * 0.65;
        p._targetY = waveBaseY + breathe * (H * 0.055) + pd * (pressY - waveBaseY) * 0.08;
      } else {
        p._targetY = waveBaseY + breathe * (H * 0.055);
      }
      if (!p.sy) p.sy = p.y;
      p.y = p.y * 0.82 + p._targetY * 0.18;
    }
  }

  function getPressInfluence(px, py) {
    // how much this point on the wave is under the baren
    var d = Math.hypot(px - pressX, (py - pressY) * 0.65);
    if (d > 95) return 0;
    return (1 - d / 95) * pressDepth;
  }

  // Draw order: paper (image + fiber) -> horizon base image -> mist (drifting) -> ink wave (multi-pass) -> bleeds/deepening -> vignette
  function drawPaper() {
    ctx.save();
    if (assets.paperOk) {
      ctx.globalAlpha = 0.98;
      ctx.drawImage(assets.paper, 0, 0, W, H);
    } else {
      ctx.fillStyle = '#d4c5a9';
      ctx.fillRect(0, 0, W, H);
    }
    // live procedural fiber + laid lines (hybrid so it always feels hand-made)
    ctx.fillStyle = 'rgba(108, 92, 66, 0.035)';
    for (var i = 0; i < 240; i++) {
      var fx = ((i * 31 + 7) % W) + Math.sin(i * 0.7) * 0.8;
      var fy = ((i * 17 + 3) % H);
      ctx.fillRect(fx, fy, 1.1, 1.9);
    }
    ctx.fillStyle = 'rgba(108, 92, 66, 0.018)';
    for (var j = 0; j < 19; j++) {
      ctx.fillRect(0, (j * 37 + 11) % H, W, 0.7);
    }
    ctx.restore();
  }

  function drawHorizonBase() {
    if (!assets.horizonOk) return;
    ctx.save();
    ctx.globalAlpha = 0.82 + Math.min(0.12, cumulative * 0.09);
    // slight vertical breathing with the wave
    var oy = Math.sin(globalTime * 0.0004) * 1.6;
    ctx.drawImage(assets.horizon, 28, waveBaseY - H * 0.21 + oy, W - 56, H * 0.42);
    ctx.restore();
  }

  function drawMist(t) {
    ctx.save();
    for (var k = 0; k < mist.length; k++) {
      var m = mist[k];
      var ax = Math.sin(m.phase + t * 0.00022) * (3 + m.layer);
      var ay = Math.cos(m.phase * 0.7 + t * 0.00019) * (1.2 + m.layer * 0.4);
      var alpha = m.a * (0.7 + (2 - m.layer) * 0.18) * (1 - Math.min(0.6, cumulative * 0.45));
      if (assets.mistOk) {
        ctx.globalAlpha = alpha * 0.72;
        ctx.drawImage(assets.mist, m.x - m.r * 0.7 + ax, m.y - m.r * 0.38 + ay, m.r * 1.4, m.r * 0.76);
      } else {
        // procedural fallback mist
        ctx.globalAlpha = alpha;
        ctx.fillStyle = '#d8d2c4';
        ctx.beginPath();
        ctx.ellipse(m.x + ax, m.y + ay, m.r * 0.9, m.r * 0.42, -0.1 + m.layer * 0.05, 0, Math.PI * 2);
        ctx.fill();
      }
    }
    ctx.restore();
  }

  function drawWave(t) {
    if (wavePoints.length < 3) return;
    var frantic = isFrantic();
    ctx.save();

    // back ink passes (feathered bleed)
    ctx.strokeStyle = 'rgba(22,24,42,0.22)';
    ctx.lineWidth = 5.8;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.beginPath();
    for (var i = 0; i < wavePoints.length; i++) {
      var p = wavePoints[i];
      var inf = getPressInfluence(p.x, p.y);
      var ox = (Math.random() - 0.5) * inf * 0.8; // tiny live bleed
      if (i === 0) ctx.moveTo(p.x + ox, p.y);
      else ctx.lineTo(p.x + ox, p.y);
    }
    ctx.stroke();

    // main body
    ctx.strokeStyle = '#16182a';
    ctx.lineWidth = 2.35;
    ctx.globalAlpha = 0.96 + cumulative * 0.04;
    ctx.beginPath();
    for (var j = 0; j < wavePoints.length; j++) {
      var q = wavePoints[j];
      var inf2 = getPressInfluence(q.x, q.y) * (frantic ? 0.35 : 1);
      var oy = inf2 * 1.6;
      if (j === 0) ctx.moveTo(q.x, q.y + oy);
      else ctx.lineTo(q.x, q.y + oy);
    }
    ctx.stroke();

    // top highlight edge (carved feeling)
    ctx.strokeStyle = 'rgba(68,72,95,0.65)';
    ctx.lineWidth = 1.05;
    ctx.globalAlpha = 0.7;
    ctx.beginPath();
    for (var k = 0; k < wavePoints.length; k++) {
      var r = wavePoints[k];
      var inf3 = getPressInfluence(r.x, r.y);
      if (k === 0) ctx.moveTo(r.x, r.y - 0.6 - inf3 * 0.4);
      else ctx.lineTo(r.x, r.y - 0.6 - inf3 * 0.4);
    }
    ctx.stroke();

    ctx.restore();
  }

  function drawDeepening() {
    if (pressDepth < 0.04 && bleeds.length === 0 && cumulative < 0.05) return;
    ctx.save();

    // local deepening under baren + outward bleed
    if (pressDepth > 0.06) {
      var grad = ctx.createRadialGradient(pressX, pressY, 6, pressX, pressY, 68 + pressDepth * 22);
      grad.addColorStop(0, 'rgba(22,24,42,' + (0.18 + pressDepth * 0.22) + ')');
      grad.addColorStop(0.55, 'rgba(22,24,42,' + (0.07 + pressDepth * 0.09) + ')');
      grad.addColorStop(1, 'rgba(22,24,42,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(pressX - 92, pressY - 72, 184, 144);
    }

    // growing bleed tendrils
    ctx.strokeStyle = 'rgba(22,24,42,0.55)';
    ctx.lineWidth = 1.6;
    ctx.lineCap = 'round';
    for (var i = 0; i < bleeds.length; i++) {
      var b = bleeds[i];
      var a = Math.max(0.12, b.life * 0.9);
      ctx.globalAlpha = a;
      ctx.beginPath();
      ctx.arc(b.x, b.y, Math.max(0.8, b.r), 0, Math.PI * 2);
      ctx.stroke();
      // faint wick
      if (b.life > 0.3) {
        ctx.globalAlpha = a * 0.4;
        ctx.beginPath();
        ctx.moveTo(b.x, b.y);
        ctx.lineTo(b.x + b.vx * 9, b.y + b.vy * 11);
        ctx.stroke();
      }
    }

    // global settling from long quiet hold — the horizon "carves" itself deeper
    if (cumulative > 0.18) {
      ctx.strokeStyle = '#16182a';
      ctx.lineWidth = 1.1;
      ctx.globalAlpha = (cumulative - 0.18) * 0.55;
      ctx.beginPath();
      for (var w = 0; w < wavePoints.length; w++) {
        var wp = wavePoints[w];
        if (w === 0) ctx.moveTo(wp.x, wp.y + 0.8);
        else ctx.lineTo(wp.x, wp.y + 0.8);
      }
      ctx.stroke();
    }

    ctx.restore();
  }

  function drawVignette() {
    ctx.save();
    var g = ctx.createRadialGradient(W * 0.5, H * 0.48, Math.min(W, H) * 0.32, W * 0.5, H * 0.5, Math.max(W, H) * 0.72);
    g.addColorStop(0, 'rgba(0,0,0,0)');
    g.addColorStop(0.82, 'rgba(18,16,12,0.035)');
    g.addColorStop(1, 'rgba(12,10,7,0.12)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
    ctx.restore();
  }

  var VERIFY = /[?&](verify|sim)=1/.test(location.search);

  function draw(dt) {
    ctx.save();
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    drawPaper();
    drawHorizonBase();
    drawMist(globalTime);
    drawWave(globalTime);

    // local baren deepening + cumulative settling
    drawDeepening();

    // very subtle vignette for depth
    drawVignette();

    // Verification harness (gated, zero effect on normal first-sight or play)
    if (VERIFY) {
      // force a sustained quiet hold state so post-capture clearly shows interaction was exercised
      pressDepth = 0.82;
      cumulative = Math.max(cumulative, 0.74);
      // paint a tiny non-intrusive evidence marker (top-left, low opacity)
      ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
      ctx.fillStyle = 'rgba(22,24,42,0.28)';
      ctx.fillText('FOLLOWUP-LIVE-OK', 14, 18);
      // also force one bleed for visual proof of press
      if (bleeds.length < 2) addBleed(W * 0.48, waveBaseY - 6, 0.9);
    }

    ctx.restore();
  }

  function frame(now) {
    if (!now) now = performance.now();
    var dt = Math.min(42, now - (lastT || now));
    lastT = now;
    globalTime += dt;

    updatePress(dt, now);
    updateWave(dt);
    updateMist(dt);
    updateBleeds(dt);

    // sparse dry baren drag only while actually pressing and not frantic
    if (isPressing && pressDepth > 0.22 && !isFrantic()) {
      initAudioIfNeeded();
      if (audioMaster) audioMaster.gain.value = 0.65 + pressDepth * 0.3;
      playBarenDrag(pressDepth);
    } else if (audioMaster) {
      audioMaster.gain.value = Math.max(0.0001, audioMaster.gain.value * 0.82);
    }

    // occasionally seed a bleed while holding (organic wick)
    if (isPressing && pressDepth > 0.35 && Math.random() < 0.12) {
      addBleed(pressX + (Math.random() - 0.5) * 14, pressY + (Math.random() - 0.5) * 9, pressDepth);
    }

    draw(dt);

    requestAnimationFrame(frame);
  }

  // Input — holding anywhere is the baren press. Frantic ignored.
  function setPress(e, down, clientX, clientY) {
    var rect = canvas.getBoundingClientRect();
    pressX = (clientX - rect.left) * (W / rect.width);
    pressY = (clientY - rect.top) * (H / rect.height);
    var wasPressing = isPressing;
    isPressing = down;
    if (down && !wasPressing) {
      pressTime = 0;
      // seed initial bleed on contact
      addBleed(pressX, pressY, 0.6);
      initAudioIfNeeded();
    }
    if (down) {
      // immediate visual response
      draw(8);
    }
  }

  canvas.addEventListener('pointerdown', function (e) {
    e.preventDefault();
    setPress(e, true, e.clientX, e.clientY);
  }, { passive: false });

  canvas.addEventListener('pointermove', function (e) {
    if (isPressing) {
      setPress(e, true, e.clientX, e.clientY);
    } else {
      // track for subtle future affordance (no visible cursor change beyond css)
      var rect = canvas.getBoundingClientRect();
      pressX = (e.clientX - rect.left) * (W / rect.width);
      pressY = (e.clientY - rect.top) * (H / rect.height);
    }
  });

  window.addEventListener('pointerup', function (e) {
    isPressing = false;
  });
  window.addEventListener('pointercancel', function () { isPressing = false; });

  // Touch parity
  canvas.addEventListener('touchstart', function (e) {
    e.preventDefault();
    if (e.touches[0]) setPress(e, true, e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: false });
  canvas.addEventListener('touchmove', function (e) {
    e.preventDefault();
    if (e.touches[0] && isPressing) setPress(e, true, e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: false });
  canvas.addEventListener('touchend', function (e) {
    e.preventDefault();
    isPressing = false;
  });

  // Keyboard: space/enter acts as hold while "over" the piece (always true here)
  var kbdPress = false;
  window.addEventListener('keydown', function (e) {
    if ((e.key === ' ' || e.key === 'Enter') && !kbdPress) {
      e.preventDefault();
      kbdPress = true;
      isPressing = true;
      pressTime = 0;
      if (pressX < 10) { pressX = W * 0.5; pressY = waveBaseY; }
      addBleed(pressX, pressY, 0.55);
      initAudioIfNeeded();
      draw(8);
    }
  });
  window.addEventListener('keyup', function (e) {
    if (e.key === ' ' || e.key === 'Enter') {
      kbdPress = false;
      isPressing = false;
    }
  });

  // Resize handling (keeps wave in composition)
  window.addEventListener('resize', function () {
    resize();
    generateWavePoints();
    draw(16);
  });

  // Boot
  function boot() {
    resize();
    generateWavePoints();

    // start with a tiny bit of life so first sight is not dead static
    cumulative = 0.03;
    pressX = W * 0.47;
    pressY = waveBaseY - 4;

    // kick assets (they call draw when ready; also draw immediately with fallbacks)
    setTimeout(function () { draw(16); }, 40);

    // gentle idle drift start
    requestAnimationFrame(frame);

    // If verify mode, seed a resolved-ish state for post evidence (still starts beautiful on first paint)
    if (VERIFY) {
      setTimeout(function () {
        cumulative = 0.71;
        pressDepth = 0.78;
        isPressing = true;
        pressX = W * 0.49;
        pressY = waveBaseY + 3;
        addBleed(pressX, pressY, 0.9);
        draw(16);
      }, 180);
    }

    // Ensure at least one paint even if images are slow
    setTimeout(function () { if (assetsLoaded < 3) draw(16); }, 380);
  }

  boot();
})();
</script>

